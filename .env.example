
# Alpha-Engine2 environment template. Copy to .env and replace placeholders.
APP_ENV=development
TZ=Asia/Riyadh

DB_HOST=postgres
DB_PORT=5432
DB_NAME=alpha_engine
DB_USER=alpha_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://alpha_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/alpha_engine

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

SAHMK_API_KEY=CHANGE_ME_SAHMK_API_KEY
SAHMK_WEBSOCKET_URL=wss://app.sahmk.sa/ws/v1/stocks/

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGE_ME_TELEGRAM_CHAT_ID

ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY
