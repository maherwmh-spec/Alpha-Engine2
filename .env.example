# Alpha-Engine2 environment template.
# Copy to .env and replace placeholders with real values.
# NEVER commit .env to git.

# عام
APP_ENV=production
TZ=Asia/Riyadh
DEBUG=false

# قاعدة البيانات (أسماء Docker + أسماء المشروع)
POSTGRES_USER=alpha_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=alpha_engine

DB_HOST=postgres
DB_PORT=5432
DB_USER=alpha_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=alpha_engine
DATABASE_URL=postgresql://alpha_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/alpha_engine

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# SahmK
SAHMK_API_KEY=CHANGE_ME_SAHMK_API_KEY
SAHMK_WEBSOCKET_URL=wss://app.sahmk.sa/ws/v1/stocks/
SAHMK_BASE_URL=https://app.sahmk.sa/api/v1

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGE_ME_TELEGRAM_CHAT_ID

# Admin (only if you start the FastAPI service manually)
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY
